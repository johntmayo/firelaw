# Altadena Fire Law Tracker — API Configuration
# Copy this file to .env.local and fill in your keys.
# All APIs below are free — no credit card required.

# ── LegiScan API (RECOMMENDED — covers both federal + California state) ───────
# Best option: one key covers both Congress and California Legislature.
# Sign up at: https://legiscan.com/legiscan-register
LEGISCAN_API_KEY=

# ── Congress.gov API (Federal legislation only) ───────────────────────────────
# Alternative to LegiScan for federal bills only.
# Sign up at: https://api.congress.gov/sign-up
CONGRESS_API_KEY=

# ── OpenStates API (California state legislation only) ────────────────────────
# Alternative to LegiScan for California state bills only.
# Sign up at: https://openstates.org/accounts/profile/
OPENSTATES_API_KEY=

# ── Notes ─────────────────────────────────────────────────────────────────────
# - If LEGISCAN_API_KEY is set, it takes precedence over the other two.
# - You can set any combination — the app falls back to curated data for any
#   source without a configured key.
# - The app works without any keys using curated/manually researched bill data.
